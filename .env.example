# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# --- откуда брать правила ---------------------------------------------------
# Адрес репозитория по HTTPS. SSH не поддерживается — в контейнере нет ключей.
GITLAB_REPO=https://gitlab.example.ru/exchange/rules.git

# Токен на чтение. В GitLab: Settings → Repository → Deploy tokens,
# область read_repository. Личный токен тоже подойдёт, но deploy-токен лучше:
# он привязан к репозиторию, а не к человеку.
GITLAB_TOKEN=

# Ветка, из которой забирать правила. Пусто — ветка по умолчанию.
# Укажите ту, где лежат боевые правила, а не черновики.
GITLAB_BRANCH=main

# Подкаталог внутри репозитория, если папки направлений лежат не в корне.
# Пример: exchange/rules
RULES_SUBDIR=

# --- обновление -------------------------------------------------------------
# Период опроса в секундах. 3600 — раз в час. 0 — не опрашивать вовсе.
REFRESH_INTERVAL=3600

# Пароль для команды «обновить» из чата. Пусто — команда недоступна.
REFRESH_PASSWORD=

# --- прочее -----------------------------------------------------------------
# Каталог с правилами внутри контейнера. Менять обычно не нужно.
RULES_DIR=/data/rules
PORT=8000
